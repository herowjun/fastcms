<configuration>
    
    <springProperty scope="context" name="logPath" source="log.path" defaultValue="${user.home}/fastcms/logs"/>
    
    <property name="LOG_HOME" value="${logPath}"/>
    
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <appender name="rootFile"
        class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/fastcms.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/fastcms.log.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <Pattern>%date %level %msg%n%n</Pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="dev">
        <logger name="org.springframework" level="INFO">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.catalina.startup.DigesterFactory" level="INFO">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.catalina.util.LifecycleBase" level="ERROR">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.coyote.http11.Http11NioProtocol" level="WARN">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.tomcat.util.net.NioSelectorPool" level="WARN">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.ibatis" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="com.baomidou.mybatisplus" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.mybatis.spring" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.pf4j" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="com.fastcms" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="freemarker.template" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.springframework.security" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.springframework.security.oauth2" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <springProfile name="prod">
        <logger name="org.springframework.boot.web.embedded.tomcat" level="INFO">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="com.fastcms.web.Fastcms" level="INFO">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.catalina.startup.DigesterFactory" level="INFO">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.catalina.util.LifecycleBase" level="ERROR">
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.coyote.http11.Http11NioProtocol" level="WARN">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.tomcat.util.net.NioSelectorPool" level="WARN">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.apache.ibatis" level="ERROR">
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.baomidou.mybatisplus" level="ERROR">
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.mybatis.spring" level="ERROR">
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.fastcms" level="ERROR">
            <appender-ref ref="rootFile"/>
        </logger>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="rootFile"/>
    </root>

</configuration>
