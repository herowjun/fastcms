    "<section class=\"py-20 md:py-24\">\n  <div class=\"max-w-6xl mx-auto px-4\">\n    <div class=\"text-center mb-14\">\n      <h2 class=\"text-2xl md:text-3xl font-bold text-slate-900\">分区标题</h2>\n      <p class=\"text-slate-400 mt-3 text-sm\">分区副标题，保持轻盈的说明语气</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-8 hover:shadow-md transition\">\n        <div class=\"w-11 h-11 bg-primary-50 rounded-full flex items-center justify-center mb-5\"><span class=\"text-primary-600 font-semibold\">01</span></div>\n        <h3 class=\"text-base font-semibold text-slate-900 mb-2\">卡片标题</h3>\n        <p class=\"text-slate-500 text-sm leading-relaxed\">卡片说明两到三行，间距宽松、行高舒适。</p>\n      </div>\n    </div>\n  </div>\n</section>"
