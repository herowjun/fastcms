<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>fastcms</artifactId>
        <groupId>com.fastcms</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <artifactId>fastcms-plugins</artifactId>
    <name>plugins-${project.version}</name>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-assembly-plugin.version>3.1.1</maven-assembly-plugin.version>
        <!--
          插件声明的 fastcms 最低兼容版本（写入 manifest 的 Plugin-Fastcms-Version 键）。
          主程序启动时比对：低于此值则拒绝加载该插件，避免「插件比主程序新、调用了不存在的能力」。
          语义是「插件要求的 fastcms 主程序版本 >= 此值」，故填 fastcms 当前发布版本。
        -->
        <fastcms.min.version>1.0.0</fastcms.min.version>
    </properties>

    <modules>
        <module>hello-world-plugin</module>
        <module>twplus-components-plugin</module>
        <module>article-skills-plugin</module>
        <module>template-skills-plugin</module>
        <module>design-skills-plugin</module>
        <module>ai-subscription-plugin</module>
    </modules>

    <dependencyManagement>

        <dependencies>

            <dependency>
                <groupId>com.fastcms</groupId>
                <artifactId>fastcms-core</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <!-- 是否替换资源中的属性 -->
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.html</include>
                    <include>**/*.sql</include>
                </includes>
                <!-- 是否替换资源中的属性 -->
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>